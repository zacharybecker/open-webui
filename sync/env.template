# Confluence Configuration
# For single space sync
SPACE_KEY=your-space-key
# For multiple spaces (comma-separated)
SPACES=SPACE1,SPACE2,SPACE3
# For syncing all accessible spaces
SYNC_ALL_SPACES=false
# For listing spaces only
LIST_SPACES=false

CONFLUENCE_URL=https://your-company.atlassian.net
CONFLUENCE_USERNAME=your-email@company.com
CONFLUENCE_TOKEN=your-api-token

# Open WebUI Configuration (not needed for --list-spaces)
OPENWEBUI_URL=http://localhost:3000
API_KEY=your-openwebui-api-key

# Optional Configuration
KNOWLEDGE_BASE_NAME=Confluence-Docs
DESCRIPTION=Documentation synced from Confluence
FORCE_REFRESH=false
TRACKING_FILE=confluence_sync_tracking.json
LOG_LEVEL=INFO